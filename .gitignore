# Things that are generated, installed, or secret. Nothing here belongs in a commit.
# Add build output of any tool you introduce; never remove the .env or certs lines.

# --- node ---
node_modules/
dist/
dist-ssr/
*.local
.vite/
npm-debug.log*
yarn-error.log*

# --- python ---
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- secrets ---
# .env holds real API keys. .env.example is committed and holds names only.
.env
.env.*
!.env.example

# --- local HTTPS certificates (@vitejs/plugin-basic-ssl regenerates them; never commit) ---
certs/
*.pem
*.key
*.crt

# --- editors and OS ---
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
backend/data/
.vercel
.env*
