# Copy to .env (same folder — the backend only reads backend/.env, not a parent one):
#   cp .env.example .env
#
# Paste real values into .env only. Never commit .env, never put a key in a source
# file — settings.py loads this file into the process environment on import, which is
# how the SDKs and /api/health see the keys.

# --- server ---------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
RELOAD=true

# --- CORS -----------------------------------------------------------------
# Private-LAN origins (10.x, 192.168.x, 172.16-31.x, *.local) are already allowed
# by regex. Only list extras here, e.g. a tunnel URL. Comma-separated.
EXTRA_ALLOWED_ORIGINS=

# --- env var contract -----------------------------------------------------
# NAMES ONLY, comma-separated. /api/health returns 503 if a REQUIRED_ENV name
# is not set, so a missing key fails loudly at the health check instead of
# halfway through a demo.
#
# ANTHROPIC_API_KEY is required: without it nothing reads the user's numbers and
# the app has nothing to show. The rest are optional because each degrades to one
# named, visible failure in one feature instead of a dead app — OPENAI_API_KEY is
# only the third link in the model fallback chain, without TAVILY_API_KEY the
# price-evidence panel returns 503 search_key_missing and says so, and without
# GROQ_API_KEY the mic button reports that voice input is unconfigured and the
# text field keeps working.
REQUIRED_ENV=ANTHROPIC_API_KEY
OPTIONAL_ENV=OPENAI_API_KEY,TAVILY_API_KEY,GROQ_API_KEY

# --- keys -----------------------------------------------------------------
# Loaded into the process environment by settings.py, so os.getenv() and the
# openai/anthropic SDKs see them. A var already exported in your shell wins.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
TAVILY_API_KEY=
GROQ_API_KEY=

# --- storage --------------------------------------------------------------
# Where store_router.py keeps the scan history. Default: backend/data/store.db.
# STORE_DB_PATH=
